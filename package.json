  },
  "license": "MIT",
  "homepage": "https://arcnode.dev/projects/arcjournal",
  "repository": {
    "type": "git",
    "url": "https://github.com/stinoooo/ArcJournal.git"
  },
  "main": "electron/main.js",
  "engines": {
    "node": ">=22.12"
  },
  "arcnode": {
    "issuer": "https://backboard.arcnode.dev",
    "clientId": "arc_f430bb7fde7e3da2926904efe1b0fbda",
    "redirectPorts": [
      47825,
      47826
    ]
  },
  "scripts": {
    "dev": "concurrently -k -n api,ui,app \"npm --prefix server run dev\" \"npm --prefix client run dev\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "build": "npm --prefix client run build",
    "test": "node --test \"electron/*.test.js\" && npm --prefix server test && npm --prefix client test",
    "icons": "node tools/make-icons.mjs",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make",
    "publish": "npm run build && electron-forge publish",
    "setup": "npm install && npm --prefix client install && npm --prefix server install"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-dmg": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/publisher-github": "^8.0.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.1.0",
    "png2icons": "^2.0.1",
    "sharp": "^0.35.5",
    "wait-on": "^9.5.1"
  }
}
