# ArcJournal API. Copy to .env in the repository root; never commit .env.

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/arcjournal

# Backboard, the Arcnode identity provider. Tokens are verified against its keys.
ARCNODE_ISSUER=https://backboard.arcnode.dev
ARCNODE_JWKS_URL=https://backboard.arcnode.dev/.well-known/jwks.json
# The ArcJournal OAuth client ID registered in Backboard. Every sign-in is
# refused while this is empty.
ARCJOURNAL_CLIENT_ID=

# Signs password sessions for ArcJournal 1.x accounts that are not linked to
# Arcnode yet. Keep the value the 1.x server used.
JWT_SECRET=

# Extra browser origins allowed to call the API (comma-separated).
# The desktop app (app://arcjournal) is always allowed.
CORS_ORIGINS=http://localhost:5173

PORT=8080
